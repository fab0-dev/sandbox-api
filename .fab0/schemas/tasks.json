{
  "$comment": "from fab0-dev/fab0-examples delivery--v0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The team's task list: one pull request per task, in this repository",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "files"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^T[1-9][0-9]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "depends_on": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
